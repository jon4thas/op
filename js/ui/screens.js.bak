// ======================================================
// screens.js — Telas dinâmicas por missão
// ======================================================
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

import { state } from '../game/state.js';
import { flow, FASE } from '../game/flow.js';
import { BLOCOS_DISPONIVEIS } from '../game/evaluator.js';
import { getMissao } from '../game/missoes/index.js';

import {
  listarPersonagens,
  listarItensLoja,
  CATEGORIAS_LOJA
} from '../game/shop.js';

// ======================================================
// HELPERS
// ======================================================
const overlay = () => document.getElementById('screens-overlay');

const setHTML = (id, html) => {
  const el = document.getElementById(id);
  if (el) el.innerHTML = html;
};

const setText = (id, txt) => {
  const el = document.getElementById(id);
  if (el) el.textContent = txt;
};

const setDisplay = (id, display) => {
  const el = document.getElementById(id);
  if (el) el.style.display = display;
};

// ======================================================
// ESTADO DA LOJA
// ======================================================
let categoriaLojaAtiva = 'todos';
let itemLojaSelecionado = 'motor';
let lojaLoadToken = 0;

let lojaViewer = {
  scene: null, camera: null, renderer: null, controls: null, loader: null, model: null, animationId: null, resizeObserver: null
};

// ======================================================
// RENDER PRINCIPAL
// ======================================================
function render() {
  destruirViewerLoja();
  setHTML('screens-overlay', '');

  const fase = flow.fase;

  setDisplay('workshop-hud', 'none');
  setDisplay('btn-help', 'none');
  setDisplay('shop-hud', 'none');

  // ── WORKSHOP ──────────────────────────────────────
  if (fase === FASE.WORKSHOP) {
    setDisplay('workshop-hud', 'block');
    setDisplay('btn-help', 'block');
    setDisplay('shop-hud', 'block');

    setText('panel-title', 'Oficina Central');
    setText('panel-sub', 'Exploração');

    const desafios = [
      { id: 'missao01', titulo: 'Motor', desc: 'Lógica e Diagnóstico' },
      { id: 'missao02', titulo: 'Sistema Elétrico', desc: 'Sistemas de Numeração' },
      { id: 'missao03', titulo: 'Automação', desc: 'Algoritmos' }
    ];

    setHTML('panel-content', `
      <h3 style="font-size:13px; color:var(--accent); margin:16px 0 8px; text-transform:uppercase; letter-spacing:1px;">
        Desafios
      </h3>

      ${desafios.map(d => {
        const done = state.desafiosConcluidos.includes(d.id);
        return `
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border);">
            <div style="width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; flex-shrink:0; background:${done ? 'var(--ok)' : 'transparent'}; border:1.5px solid ${done ? 'var(--ok)' : 'var(--border)'}; color:${done ? '#fff' : 'var(--muted)'};">
              ${done ? '✓' : ''}
            </div>
            <div style="flex:1;">
              <div style="font-size:14px; color:${done ? 'var(--ok)' : 'var(--text)'}; font-weight:600;">
                ${d.titulo}
              </div>
              <div style="font-size:12px; color:var(--muted);">
                ${d.desc}
              </div>
            </div>
          </div>
        `;
      }).join('')}

      <hr style="margin:16px 0;border-color:var(--border);">

      <div style="display:flex;justify-content:space-between;padding:6px 0;">
        <span style="color:var(--muted);font-size:14px;">💰 Dinheiro</span>
        <strong style="color:var(--ok);font-size:16px;">R$ ${state.dinheiro}</strong>
      </div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;">
        <span style="color:var(--muted);font-size:14px;">⭐ XP</span>
        <strong style="color:var(--accent);font-size:16px;">${state.xp} XP</strong>
      </div>
      <div style="display:flex;justify-content:space-between;padding:6px 0;">
        <span style="color:var(--muted);font-size:14px;">🏆 Desafios</span>
        <strong style="color:var(--warn);font-size:16px;">${state.desafiosConcluidos.length}/3</strong>
      </div>
    `);
    return;
  }

  // ── MENU ──────────────────────────────────────────
  if (fase === FASE.MENU) {
    if (!state.boasVindasVistas) {
      overlay().innerHTML = renderBoasVindas();
    } else {
      overlay().innerHTML = renderMenu();
    }
  }

  // ── TELAS DE MISSÃO ───────────────────────────────
  else {
    setDisplay('btn-help', 'block');

    if (fase === FASE.RECEPCAO) overlay().innerHTML = renderRecepcao();
    else if (fase === FASE.DESAFIO) overlay().innerHTML = renderDesafio();
    else if (fase === FASE.RESULTADO) overlay().innerHTML = renderResultado();
    else if (fase === FASE.LOJA) {
      overlay().innerHTML = renderLoja();
      iniciarViewerLoja();
    }
  }

  atualizarPainelLateral();
}

// ======================================================
// MENUS (Mantidos do seu arquivo original)
// ======================================================

